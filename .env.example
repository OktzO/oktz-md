TURSO_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token

APIKEY_NEOXR=
APIKEY_FGSI=
GROQ_API_KEY=
APIKEY_COVENANT=
APIKEY_OBSCURA=
APIKEY_FIREFLY=
APIKEY_CUKI=

# API keys (rotasi yang lama — pernah hardcoded & committed)
FGSI_API_KEY=
TOPMEDIA_API_KEY=

# Upload provider (wajib untuk fitur yang pakai termai/telegraph)
TERMAI_UPLOAD_KEY=
# Pastebin API dev key (ambil di https://pastebin.com/api)
PASTEBIN_DEV_KEY=
#
# ---------------------------------------------------------------------------
# Status tiap key (dicek langsung 2026-09-26 — JANGAN assume masih hidup)
# ---------------------------------------------------------------------------
# APIKEY_FIREFLY  -> firefly.maiku.my.id  HTTP 530 (HOST MATI)
#     Dipakai: igstalk, ytstalk, text2img
#     3 plugin itu sudah otomatis jatuh ke fallback / pesan "key belum diset".
# APIKEY_CUKI     -> api.cuki.biz.id      401 "API key required" (host hidup)
#     Dipakai: gita, wormgpt, caribug, sendngl, lahelu, watercolortext
#     ✅ punya fallback nexray: gita, wormgpt, sendngl
#     ❌ tidak ada padanan di nexray, hanya pesan jujur soal key:
#        lahelu, caribug, watercolortext
# APIKEY_NEOXR    -> api.neoxr.eu         "apikey is required" (key ditolak)
#     Dipakai: chords, txt2img, sfiledl, musikapaini
#     Nexray tidak punya padanan chord/sfile — hanya pesan jujur soal key.
# APIKEY_COVENANT -> api.covenant.sbs     DNS gagal (fetch failed)
#     Dipakai: melolo — tidak ada fallback, hanya pesan jujur soal key.
# APIKEY_OBSCURA  -> api.obscuraworks.org 404 (host hidup, path berubah)
#     Dipakai: nikparser ✅ (fallback nexray /tools/nikparse), am-data ❌
# APIKEY_FGSI     -> fgsi.dpdns.org       belum dicek
#     Dipakai: 2 file scraper hdvid
#
# Tanpa key, host ini hidup dan dipakai sebagai fallback:
#   api.nexray.eu.cc  / .web.id   -> src/lib/stalker-fallback.js (semua fallback)
#   lrclib.net                     -> lyrics play2
#   registry.npmjs.org             -> .npm
#   api.open-meteo.com             -> cuaca di menu
#
# Endpoint nexray yang dipakai sebagai fallback (semua dicek live, tanpa key):
#   /stalker/github?username=      /stalker/tiktok?username=
#   /stalker/npmjs?name=           /tools/spamngl?url=&jumlah=&pesan=
#   /tools/nikparse?nik=           /ai/chatgpt?text=   /ai/gitagpt?text=
#   /stalker/instagram 500 (tidak dipakai)  /stalker/youtube 500 (tidak dipakai)
#
# API-FAA (api-faa.my.id): endpoint-nya SEHAT (dicek via browser → 200 PNG),
# tapi WAF Cloudflare memblokir /faa/* untuk IP server kita → 403 "Attention
# Required!". Bukan challenge, bukan salah path. Perlu whitelist IP VPS di WAF
# FAA dulu. Sambil itu, 12 method di src/lib/apimanager.js ApiFaaProvider idle.
# Linode API token (panel linode)
LINODE_API_TOKEN=
# Opsional — override default di code
IMGDROP_COOKIE=
# Default = font/emoji brat dari raw.githubusercontent (kalau mati, fallback font lokal assets/font.ttf)
BRAT_FONT_URL=https://raw.githubusercontent.com/Ditzzx-vibecoder/Assets/main/Font/ARIALN.ttf
BRAT_EMOJI_URL=https://media.githubusercontent.com/media/Ditzzx-vibecoder/entahlah/main/emoji-apple.json
FFMPEG_PATH=
FFPROBE_PATH=

# FGSI_API_KEY = alias lama key FGSI (scraper hdvid)
