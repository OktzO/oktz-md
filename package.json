{
  "name": "ourin-md",
  "version": "3.3.1",
  "description": "WhatsApp Multi-Device Bot dengan sistem plugin modular",
  "main": "index.js",
  "scripts": {
    "start": "set NODE_ENV=development&& node --max-old-space-size=512 --expose-gc index.js",
    "dev": "node --max-old-space-size=512 --expose-gc index.js",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "lint": "eslint plugins/",
    "postinstall": "node -e \"try{require('sharp')}catch(e){require('child_process').execSync('npm rebuild sharp --foreground-scripts',{stdio:'inherit'})}\" && node native/fetch-prebuilt.mjs"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "multi-device",
    "plugin"
  ],
  "author": "Zann",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "allowScripts": {
    "@ffmpeg-installer/linux-x64": true,
    "btch-downloader": true,
    "cpu-features": true,
    "esbuild": true,
    "protobufjs": true,
    "sharp": true,
    "ssh2": true,
    "tesseract.js": true
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@hapi/boom": "^10.0.1",
    "@libsql/client": "^0.14.0",
    "@microlink/mql": "^0.16.1",
    "@napi-rs/canvas": "^0.1.88",
    "adm-zip": "^0.6.0",
    "archiver": "^7.0.1",
    "awesome-phonenumber": "^7.7.0",
    "axios": "^1.13.2",
    "axios-cookiejar-support": "^6.0.5",
    "brat-canvas": "^1.0.26",
    "btch-downloader": "^6.0.25",
    "chalk": "^4.1.2",
    "cheerio": "^1.1.2",
    "cron": "^4.4.0",
    "file-type": "^21.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.5",
    "google-tts-api": "^2.0.2",
    "gsmarena-api": "^2.0.5",
    "he": "^1.2.0",
    "lowdb": "^7.0.1",
    "lru-cache": "^11.2.4",
    "mime-types": "^3.0.2",
    "ms": "^2.1.3",
    "node-cache": "^5.1.2",
    "node-fetch": "^2.7.0",
    "node-upload-images": "^1.0.1",
    "ourin": "npm:oktz-baileys@^9.1.5",
    "pino": "^9.14.0",
    "qrcode": "^1.5.4",
    "qs": "^6.14.1",
    "rate-limiter-flexible": "^9.1.1",
    "sharp": "^0.35.3",
    "ssh2": "^1.17.0",
    "tesseract.js": "^7.0.0",
    "tough-cookie": "^6.0.0",
    "undici": "^7.22.0",
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "nodemon": "^3.1.11"
  },
  "overrides": {
    "axios": "$axios",
    "form-data": "^4.0.5",
    "image-size": "^2.0.0",
    "minimatch": "^3.1.2",
    "file-type": "^21.3.0",
    "qs": "^6.14.1",
    "esbuild": "^0.28.0",
    "clean-jsdoc-theme": "^5.1.1"
  }
}
